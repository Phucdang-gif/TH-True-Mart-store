generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model products {
  id                   String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  code                 String                 @unique
  name                 String
  categoryId           String
  unit                 String
  sellingPrice         Decimal                @db.Decimal(12, 2)
  costPrice            Decimal                @db.Decimal(12, 2)
  minStockLevel        Int                    @default(0)
  description          String?
  imageUrl             String?
  status               ProductStatus          @default(active)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now())
  batches              batches[]
  invoice_items        invoice_items[]
  price_history        price_history[]
  product_categories   product_categories     @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promotion_products   promotion_products[]
  purchase_order_items purchase_order_items[]

  @@index([categoryId])
}

model promotions {
  id                 String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  code               String               @unique
  name               String
  description        String?
  scope              PromotionScope       @default(order)
  discountType       DiscountType
  value              Decimal              @db.Decimal(12, 2)
  maxDiscountAmount  Decimal?             @db.Decimal(12, 2)
  minOrderValue      Decimal              @default(0) @db.Decimal(12, 2)
  categoryId         String?
  nearExpiryDays     Int?
  requiresCode       Boolean              @default(false)
  usageLimit         Int?
  usedCount          Int                  @default(0)
  startDate          DateTime
  endDate            DateTime
  status             PromotionStatus      @default(scheduled)
  statusChangedAt    DateTime?
  createdById        String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  invoice_promotions invoice_promotions[]
  promotion_products promotion_products[]
  product_categories product_categories?  @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff              staff                @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdById])
  @@index([status])
  @@index([categoryId])
}

model purchase_order_items {
  id              String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  purchaseOrderId String
  productId       String
  quantity        Int
  unitPrice       Decimal         @db.Decimal(12, 2)
  subtotal        Decimal?        @default(dbgenerated("((quantity)::numeric * \"unitPrice\")")) @db.Decimal(14, 2)
  products        products        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_orders purchase_orders @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId])
  @@index([purchaseOrderId])
}

model purchase_orders {
  id                   String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderCode            String                 @unique
  supplierId           String
  createdById          String
  createdAt            DateTime               @default(now())
  expectedDate         DateTime
  totalAmount          Decimal                @db.Decimal(14, 2)
  status               PurchaseOrderStatus    @default(pending)
  notes                String?
  goods_receipts       goods_receipts[]
  purchase_order_items purchase_order_items[]
  staff                staff                  @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  suppliers            suppliers              @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([supplierId])
  @@index([createdById])
}

model staff {
  id                                             String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  code                                           String             @unique
  name                                           String
  phone                                          String
  username                                       String             @unique
  password                                       String
  roleId                                         String
  status                                         StaffStatus        @default(active)
  mustChangePassword                             Boolean            @default(false)
  failedLoginCount                               Int                @default(0)
  lockedUntil                                    DateTime?
  lastLoginAt                                    DateTime?
  createdAt                                      DateTime           @default(now())
  updatedAt                                      DateTime           @default(now())
  auth_sessions                                  auth_sessions[]
  goods_receipts                                 goods_receipts[]
  invoice_payments                               invoice_payments[]
  invoices                                       invoices[]
  login_logs                                     login_logs[]
  price_history                                  price_history[]
  promotions                                     promotions[]
  purchase_orders                                purchase_orders[]
  roles                                          roles              @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stock_audits_stock_audits_approvedByIdTostaff  stock_audits[]     @relation("stock_audits_approvedByIdTostaff")
  stock_audits_stock_audits_performedByIdTostaff stock_audits[]     @relation("stock_audits_performedByIdTostaff")
  stock_movements                                stock_movements[]

  @@index([roleId])
}

model stock_audit_items {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  auditId        String
  batchId        String
  systemQuantity Int
  actualQuantity Int
  difference     Int?         @default(dbgenerated("(\"actualQuantity\" - \"systemQuantity\")"))
  reason         String?
  stock_audits   stock_audits @relation(fields: [auditId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  batches        batches      @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([auditId, batchId])
  @@index([batchId])
}

model stock_audits {
  id                                      String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  auditCode                               String              @unique
  auditDate                               DateTime            @default(now())
  performedById                           String
  approvedById                            String?
  status                                  StockAuditStatus    @default(draft)
  createdAt                               DateTime            @default(now())
  stock_audit_items                       stock_audit_items[]
  staff_stock_audits_approvedByIdTostaff  staff?              @relation("stock_audits_approvedByIdTostaff", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff_stock_audits_performedByIdTostaff staff               @relation("stock_audits_performedByIdTostaff", fields: [performedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([approvedById])
  @@index([performedById])
}

model suppliers {
  id               String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  code             String            @unique
  name             String
  contactPerson    String
  phone            String
  address          String
  categoryProvided String
  status           SupplierStatus    @default(active)
  goods_receipts   goods_receipts[]
  purchase_orders  purchase_orders[]
}

model login_logs {
  id        String     @id @default(dbgenerated("(gen_random_uuid())::text"))
  staffId   String?
  username  String
  event     LoginEvent @default(login)
  success   Boolean
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime   @default(now())
  staff     staff?     @relation(fields: [staffId], references: [id], onUpdate: NoAction)

  @@index([createdAt])
  @@index([staffId])
}

model permissions {
  id               String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  code             String             @unique
  module           String
  name             String
  description      String?
  role_permissions role_permissions[]
}

model promotion_products {
  promotionId String
  productId   String
  products    products   @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promotions  promotions @relation(fields: [promotionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([promotionId, productId])
  @@index([productId])
}

model role_permissions {
  roleId       String
  permissionId String
  permissions  permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles        roles       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model roles {
  id               String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  code             String             @unique
  name             String
  description      String?
  isSystem         Boolean            @default(false)
  createdAt        DateTime           @default(now())
  role_permissions role_permissions[]
  staff            staff[]
}

model auth_sessions {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  staffId          String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  staff            staff     @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([staffId])
}

model batches {
  id                  String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  batchCode           String                @unique
  productId           String
  manufacturingDate   DateTime
  expiryDate          DateTime
  quantity            Int                   @default(0)
  createdAt           DateTime              @default(now())
  products            products              @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  goods_receipt_items goods_receipt_items[]
  invoice_items       invoice_items[]
  stock_audit_items   stock_audit_items[]
  stock_movements     stock_movements[]

  @@index([productId])
  @@index([expiryDate])
}

model invoice_items {
  id                 String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  invoiceId          String
  productId          String
  batchId            String
  quantity           Int
  unitPrice          Decimal              @db.Decimal(12, 2)
  discount           Decimal              @default(0) @db.Decimal(12, 2)
  subtotal           Decimal?             @default(dbgenerated("(((quantity)::numeric * \"unitPrice\") - discount)")) @db.Decimal(12, 2)
  batches            batches              @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices           invoices             @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products           products             @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice_promotions invoice_promotions[]

  @@index([batchId])
  @@index([invoiceId])
  @@index([productId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invoice_payments {
  id            String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  invoiceId     String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  cashReceived  Decimal?      @db.Decimal(12, 2)
  status        PaymentStatus @default(pending)
  reference     String?
  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime      @default(now())
  staff         staff?        @relation(fields: [confirmedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices      invoices      @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([confirmedById])
  @@index([invoiceId])
  @@index([reference])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invoice_promotions {
  id             String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  invoiceId      String
  promotionId    String
  invoiceItemId  String?
  discountAmount Decimal        @db.Decimal(12, 2)
  invoices       invoices       @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoice_items  invoice_items? @relation(fields: [invoiceItemId], references: [id], onUpdate: NoAction)
  promotions     promotions     @relation(fields: [promotionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([invoiceId])
  @@index([promotionId])
}

model invoices {
  id                 String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  code               String               @unique
  cashierId          String
  subtotal           Decimal              @db.Decimal(12, 2)
  discountAmount     Decimal              @default(0) @db.Decimal(12, 2)
  finalTotal         Decimal              @db.Decimal(12, 2)
  status             InvoiceStatus        @default(draft)
  notes              String?
  createdAt          DateTime             @default(now())
  paidAt             DateTime?
  invoice_items      invoice_items[]
  invoice_payments   invoice_payments[]
  invoice_promotions invoice_promotions[]
  staff              staff                @relation(fields: [cashierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cashierId])
  @@index([paidAt])
  @@index([status])
}

model app_settings {
  key         String   @id
  value       String
  description String?
  updatedAt   DateTime @default(now())
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model goods_receipt_items {
  id             String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  receiptId      String
  batchId        String
  quantity       Int
  importPrice    Decimal        @db.Decimal(12, 2)
  batches        batches        @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  goods_receipts goods_receipts @relation(fields: [receiptId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([receiptId, batchId])
  @@index([batchId])
}

model goods_receipts {
  id                  String                @id @default(dbgenerated("(gen_random_uuid())::text"))
  code                String                @unique
  supplierId          String
  purchaseOrderId     String?
  receivedById        String
  receivedAt          DateTime              @default(now())
  notes               String?
  goods_receipt_items goods_receipt_items[]
  purchase_orders     purchase_orders?      @relation(fields: [purchaseOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff               staff                 @relation(fields: [receivedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  suppliers           suppliers             @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([purchaseOrderId])
  @@index([receivedById])
  @@index([supplierId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model price_history {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  productId   String
  oldPrice    Decimal? @db.Decimal(12, 2)
  newPrice    Decimal  @db.Decimal(12, 2)
  changedById String
  changedAt   DateTime @default(now())
  staff       staff    @relation(fields: [changedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products    products @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([changedById])
  @@index([productId, changedAt], map: "price_history_product_idx")
}

model product_categories {
  id         String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  code       String         @unique
  name       String         @unique
  status     CategoryStatus @default(active)
  createdAt  DateTime       @default(now())
  products   products[]
  promotions promotions[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stock_movements {
  id          String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  batchId     String
  type        StockMovementType
  quantity    Int
  reason      String?
  refType     String?
  refId       String?
  createdById String
  createdAt   DateTime          @default(now())
  batches     batches           @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff       staff             @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([batchId, createdAt], map: "stock_movements_batch_idx")
  @@index([createdById])
  @@index([refType, refId], map: "stock_movements_ref_idx")
}

enum DiscountType {
  percentage
  fixed_amount
}

enum InvoiceStatus {
  draft
  pending_payment
  completed
  cancelled
}

enum PaymentMethod {
  cash
  transfer
  card
}

enum ProductStatus {
  active
  discontinued
}

enum PromotionStatus {
  draft
  scheduled
  active
  paused
  expired
}

enum PurchaseOrderStatus {
  pending
  received
  cancelled
}

enum StaffStatus {
  active
  inactive
}

enum StockAuditStatus {
  draft
  pending_approval
  approved
  rejected
}

enum PaymentStatus {
  pending
  confirmed
  failed
}

enum PromotionScope {
  order
  category
  product
  near_expiry
}

enum SupplierStatus {
  active
  inactive
}

enum CategoryStatus {
  active
  inactive
}

enum LoginEvent {
  login
  logout
  lock
  unlock
}

enum StockMovementType {
  import
  sale
  export
  adjust
  audit
}
