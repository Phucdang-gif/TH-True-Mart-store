generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model batches {
  id                String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  batchCode         String          @unique
  productId         String
  manufacturingDate DateTime
  expiryDate        DateTime
  quantity          Int
  importPrice       Decimal         @db.Decimal(12, 2)
  status            BatchStatus     @default(good)
  receivedById      String?
  createdAt         DateTime        @default(now())
  products          products        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff             staff?          @relation(fields: [receivedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice_items     invoice_items[]

  @@index([productId])
  @@index([receivedById])
}

model customers {
  id         String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  code       String       @unique
  name       String
  phone      String       @unique
  email      String?
  points     Int          @default(0)
  tier       CustomerTier @default(Standard)
  totalSpent Decimal      @default(0) @db.Decimal(14, 2)
  createdAt  DateTime     @default(now())
  invoices   invoices[]
}

model invoice_approvals {
  id           String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  invoiceId    String
  action       String
  reason       String
  approvedById String
  createdAt    DateTime @default(now())
  staff        staff    @relation(fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices     invoices @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([approvedById])
  @@index([invoiceId])
}

model invoice_items {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  invoiceId String
  productId String
  batchId   String?
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)
  batches   batches? @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices  invoices @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products  products @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([batchId])
  @@index([invoiceId])
  @@index([productId])
}

model invoices {
  id                String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  code              String              @unique
  createdAt         DateTime            @default(now())
  cashierId         String
  customerId        String?
  subtotal          Decimal             @db.Decimal(12, 2)
  discountAmount    Decimal             @default(0) @db.Decimal(12, 2)
  voucherCode       String?
  pointsUsed        Int                 @default(0)
  pointsEarned      Int                 @default(0)
  finalTotal        Decimal             @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  receivedAmount    Decimal             @db.Decimal(12, 2)
  changeAmount      Decimal             @default(0) @db.Decimal(12, 2)
  status            InvoiceStatus       @default(completed)
  notes             String?
  invoice_approvals invoice_approvals[]
  invoice_items     invoice_items[]
  staff             staff               @relation(fields: [cashierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customers         customers?          @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cashierId])
  @@index([customerId])
}

model products {
  id                   String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  code                 String                 @unique
  name                 String
  category             Category
  unit                 String
  sellingPrice         Decimal                @db.Decimal(12, 2)
  costPrice            Decimal                @db.Decimal(12, 2)
  barcode              String                 @unique
  minStockLevel        Int                    @default(0)
  description          String?
  imageUrl             String?
  status               ProductStatus          @default(active)
  discountPercent      Decimal?               @db.Decimal(5, 2)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now())
  batches              batches[]
  invoice_items        invoice_items[]
  purchase_order_items purchase_order_items[]
  stock_audit_items    stock_audit_items[]
}

model promotions {
  id                 String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  code               String          @unique
  name               String
  discountType       DiscountType
  value              Decimal         @db.Decimal(12, 2)
  startDate          DateTime
  endDate            DateTime
  minOrderValue      Decimal         @default(0) @db.Decimal(12, 2)
  applicableCategory Category?
  status             PromotionStatus @default(scheduled)
  createdAt          DateTime        @default(now())
}

model purchase_order_items {
  id              String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  purchaseOrderId String
  productId       String
  quantity        Int
  unitPrice       Decimal         @db.Decimal(12, 2)
  subtotal        Decimal         @db.Decimal(12, 2)
  products        products        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_orders purchase_orders @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId])
  @@index([purchaseOrderId])
}

model purchase_orders {
  id                   String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderCode            String                 @unique
  supplierId           String
  createdAt            DateTime               @default(now())
  expectedDate         DateTime
  totalAmount          Decimal                @db.Decimal(14, 2)
  status               PurchaseOrderStatus    @default(pending)
  notes                String?
  purchase_order_items purchase_order_items[]
  suppliers            suppliers              @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([supplierId])
}

model staff {
  id                                             String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  code                                           String              @unique
  name                                           String
  phone                                          String
  email                                          String              @unique
  username                                       String              @unique
  password                                       String
  role                                           StaffRole
  status                                         StaffStatus         @default(active)
  shift                                          Shift
  createdAt                                      DateTime            @default(now())
  updatedAt                                      DateTime            @default(now())
  batches                                        batches[]
  invoice_approvals                              invoice_approvals[]
  invoices                                       invoices[]
  stock_audits_stock_audits_approvedByIdTostaff  stock_audits[]      @relation("stock_audits_approvedByIdTostaff")
  stock_audits_stock_audits_performedByIdTostaff stock_audits[]      @relation("stock_audits_performedByIdTostaff")
}

model stock_audit_items {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  stockAuditId   String
  productId      String
  systemQuantity Int
  actualQuantity Int
  difference     Int
  reason         String
  products       products     @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stock_audits   stock_audits @relation(fields: [stockAuditId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId])
  @@index([stockAuditId])
}

model stock_audits {
  id                                      String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  auditCode                               String              @unique
  auditDate                               DateTime            @default(now())
  performedById                           String
  approvedById                            String?
  status                                  StockAuditStatus    @default(draft)
  createdAt                               DateTime            @default(now())
  stock_audit_items                       stock_audit_items[]
  staff_stock_audits_approvedByIdTostaff  staff?              @relation("stock_audits_approvedByIdTostaff", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff_stock_audits_performedByIdTostaff staff               @relation("stock_audits_performedByIdTostaff", fields: [performedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([approvedById])
  @@index([performedById])
}

model suppliers {
  id               String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  code             String            @unique
  name             String
  contactPerson    String
  phone            String
  email            String
  address          String
  categoryProvided String
  status           SupplierStatus    @default(active)
  purchase_orders  purchase_orders[]
}

enum BatchStatus {
  good
  expiring_soon
  expired
}

enum Category {
  SUA_TUOI_TIET_TRUNG
  SUA_TUOI_THANH_TRUNG
  SUA_CHUA
  BO_PHOMAI
  KEM
  NUOC
  TRA
}

enum CustomerTier {
  Standard
  Silver
  Gold
  Diamond
}

enum DiscountType {
  percentage
  fixed_amount
}

enum InvoiceStatus {
  completed
  returned
  cancelled
  pending_approval
}

enum PaymentMethod {
  cash
  transfer
  card
}

enum ProductStatus {
  active
  discontinued
}

enum PromotionStatus {
  active
  expired
  scheduled
}

enum PurchaseOrderStatus {
  pending
  received
  cancelled
}

enum Shift {
  SANG
  CHIEU
  HANH_CHINH
}

enum StaffRole {
  admin
  manager
  cashier
  warehouse
}

enum StaffStatus {
  active
  inactive
}

enum StockAuditStatus {
  draft
  pending_approval
  approved
  rejected
}

enum SupplierStatus {
  active
  inactive
}
