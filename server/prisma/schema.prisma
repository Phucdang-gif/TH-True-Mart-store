generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model products {
  id                   String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  code                 String                 @unique
  name                 String
  category             Category
  unit                 String
  sellingPrice         Decimal                @db.Decimal(12, 2)
  costPrice            Decimal                @db.Decimal(12, 2)
  minStockLevel        Int                    @default(0)
  description          String?
  imageUrl             String?
  status               ProductStatus          @default(active)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now())
  batches              batches[]
  promotion_products   promotion_products[]
  purchase_order_items purchase_order_items[]
  stock_audit_items    stock_audit_items[]
}

model promotions {
  id                 String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  code               String               @unique
  name               String
  description        String?
  scope              PromotionScope       @default(order)
  discountType       DiscountType
  value              Decimal              @db.Decimal(12, 2)
  maxDiscountAmount  Decimal?             @db.Decimal(12, 2)
  startDate          DateTime
  endDate            DateTime
  minOrderValue      Decimal              @default(0) @db.Decimal(12, 2)
  applicableCategory Category?
  nearExpiryDays     Int?
  requiresCode       Boolean              @default(false)
  usageLimit         Int?
  usedCount          Int                  @default(0)
  status             PromotionStatus      @default(scheduled)
  createdById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  promotion_products promotion_products[]
  staff              staff?               @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdById])
  @@index([status])
}

model purchase_order_items {
  id              String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  purchaseOrderId String
  productId       String
  quantity        Int
  unitPrice       Decimal         @db.Decimal(12, 2)
  subtotal        Decimal         @db.Decimal(12, 2)
  products        products        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_orders purchase_orders @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId])
  @@index([purchaseOrderId])
}

model purchase_orders {
  id                   String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderCode            String                 @unique
  supplierId           String
  createdAt            DateTime               @default(now())
  expectedDate         DateTime
  totalAmount          Decimal                @db.Decimal(14, 2)
  status               PurchaseOrderStatus    @default(pending)
  notes                String?
  purchase_order_items purchase_order_items[]
  suppliers            suppliers              @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([supplierId])
}

model staff {
  id                                             String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  code                                           String                  @unique
  name                                           String
  phone                                          String
  username                                       String                  @unique
  password                                       String
  role                                           StaffRole
  roleId                                         String?
  status                                         StaffStatus             @default(active)
  shift                                          Shift
  mustChangePassword                             Boolean                 @default(false)
  failedLoginCount                               Int                     @default(0)
  lockedUntil                                    DateTime?
  lastLoginAt                                    DateTime?
  passwordChangedAt                              DateTime?
  createdAt                                      DateTime                @default(now())
  updatedAt                                      DateTime                @default(now())
  auth_sessions                                  auth_sessions[]
  batches                                        batches[]
  login_logs                                     login_logs[]
  password_reset_tokens                          password_reset_tokens[]
  promotions                                     promotions[]
  roles                                          roles?                  @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stock_audits_stock_audits_approvedByIdTostaff  stock_audits[]          @relation("stock_audits_approvedByIdTostaff")
  stock_audits_stock_audits_performedByIdTostaff stock_audits[]          @relation("stock_audits_performedByIdTostaff")

  @@index([roleId])
}

model stock_audit_items {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  stockAuditId   String
  productId      String
  systemQuantity Int
  actualQuantity Int
  difference     Int
  reason         String
  products       products     @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stock_audits   stock_audits @relation(fields: [stockAuditId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId])
  @@index([stockAuditId])
}

model stock_audits {
  id                                      String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  auditCode                               String              @unique
  auditDate                               DateTime            @default(now())
  performedById                           String
  approvedById                            String?
  status                                  StockAuditStatus    @default(draft)
  createdAt                               DateTime            @default(now())
  stock_audit_items                       stock_audit_items[]
  staff_stock_audits_approvedByIdTostaff  staff?              @relation("stock_audits_approvedByIdTostaff", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff_stock_audits_performedByIdTostaff staff               @relation("stock_audits_performedByIdTostaff", fields: [performedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([approvedById])
  @@index([performedById])
}

model suppliers {
  id               String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  code             String            @unique
  name             String
  contactPerson    String
  phone            String
  address          String
  categoryProvided String
  status           SupplierStatus    @default(active)
  purchase_orders  purchase_orders[]
}

model login_logs {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  staffId   String?
  username  String
  success   Boolean
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  staff     staff?   @relation(fields: [staffId], references: [id], onUpdate: NoAction)

  @@index([createdAt])
  @@index([staffId])
}

model password_reset_tokens {
  id        String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  staffId   String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  staff     staff     @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([staffId])
}

model permissions {
  id               String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  code             String             @unique
  module           String
  name             String
  description      String?
  role_permissions role_permissions[]
}

model promotion_products {
  promotionId String
  productId   String
  products    products   @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promotions  promotions @relation(fields: [promotionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([promotionId, productId])
  @@index([productId])
}

model role_permissions {
  roleId       String
  permissionId String
  permissions  permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles        roles       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model roles {
  id               String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  code             String             @unique
  name             String
  description      String?
  isSystem         Boolean            @default(false)
  createdAt        DateTime           @default(now())
  role_permissions role_permissions[]
  staff            staff[]
}

model auth_sessions {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  staffId          String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  staff            staff     @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([staffId])
}

model batches {
  id                String      @id @default(dbgenerated("(gen_random_uuid())::text"))
  batchCode         String      @unique
  productId         String
  manufacturingDate DateTime
  expiryDate        DateTime
  quantity          Int
  importPrice       Decimal     @db.Decimal(12, 2)
  status            BatchStatus @default(good)
  receivedById      String?
  createdAt         DateTime    @default(now())
  products          products    @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff             staff?      @relation(fields: [receivedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([productId])
  @@index([receivedById])
}

enum Category {
  SUA_TUOI_TIET_TRUNG
  SUA_TUOI_THANH_TRUNG
  SUA_CHUA
  BO_PHOMAI
  KEM
  NUOC
  TRA
}

enum DiscountType {
  percentage
  fixed_amount
}

enum InvoiceStatus {
  completed
  pending_payment
  returned
  cancelled
  pending_approval
}

enum PaymentMethod {
  cash
  transfer
  card
  mixed
}

enum ProductStatus {
  active
  discontinued
}

enum PromotionStatus {
  draft
  scheduled
  active
  paused
  expired
}

enum PurchaseOrderStatus {
  pending
  received
  cancelled
}

enum Shift {
  SANG
  CHIEU
  HANH_CHINH
}

enum StaffRole {
  manager
  cashier
  warehouse
}

enum StaffStatus {
  active
  inactive
}

enum StockAuditStatus {
  draft
  pending_approval
  approved
  rejected
}

enum PaymentStatus {
  pending
  confirmed
  failed
}

enum PromotionScope {
  order
  category
  product
  near_expiry
}

enum BatchStatus {
  good
  expiring_soon
  expired
}

enum CashSessionStatus {
  open
  closed
  reviewed
}

enum SupplierStatus {
  active
  inactive
}
