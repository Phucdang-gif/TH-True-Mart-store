generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 5. Nhân viên: vai trò, quyền, tài khoản, phiên, nhật ký ============

model roles {
  id               String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  code             String             @unique
  name             String
  description      String?
  isSystem         Boolean            @default(false)
  createdAt        DateTime           @default(now())
  role_permissions role_permissions[]
  staff            staff[]
}

model permissions {
  id               String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  code             String             @unique
  module           String
  name             String
  description      String?
  role_permissions role_permissions[]
}

model role_permissions {
  roleId       String
  permissionId String
  permissions  permissions @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles        roles       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model staff {
  id                String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  code              String             @unique @default(dbgenerated("next_code('NV'::text, 'staff_code_seq'::regclass, 3, 'staff'::text, 'code'::text)"))
  name              String
  phone             String
  username          String             @unique
  password          String
  roleId            String
  status            StaffStatus        @default(active)
  failedLoginCount  Int                @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @default(now())
  auth_sessions     auth_sessions[]
  batches           batches[]
  invoice_payments  invoice_payments[]
  invoices          invoices[]
  login_logs        login_logs[]
  price_history     price_history[]
  promotions        promotions[]
  roles             roles              @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stock_audits_approved  stock_audits[] @relation("stock_audits_approvedByIdTostaff")
  stock_audits_performed stock_audits[] @relation("stock_audits_performedByIdTostaff")
  stock_movements   stock_movements[]

  @@index([roleId])
}

model auth_sessions {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  staffId          String
  refreshTokenHash String    @unique
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  staff            staff     @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([staffId])
}

model login_logs {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  staffId   String?
  username  String
  success   Boolean
  reason    String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  staff     staff?   @relation(fields: [staffId], references: [id], onUpdate: NoAction)

  @@index([createdAt])
  @@index([staffId])
}

// ============ 2. Hàng hóa; 4. Lô hàng, xuất kho ============

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id                   String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  code                 String                 @unique
  name                 String
  category             Category
  unit                 String
  sellingPrice         Decimal                @db.Decimal(12, 2)
  minStockLevel        Int                    @default(0)
  status               ProductStatus          @default(active)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @default(now())
  batches              batches[]
  invoice_items        invoice_items[]
  price_history        price_history[]
  promotion_products   promotion_products[]
  purchase_order_items purchase_order_items[]
  stock_audit_items    stock_audit_items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model price_history {
  id          String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  productId   String
  oldPrice    Decimal  @db.Decimal(12, 2)
  newPrice    Decimal  @db.Decimal(12, 2)
  changedById String
  changedAt   DateTime @default(now())
  staff       staff    @relation(fields: [changedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products    products @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([changedById])
  @@index([productId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model batches {
  id                String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  batchCode         String            @unique
  productId         String
  manufacturingDate DateTime
  expiryDate        DateTime
  quantity          Int
  importPrice       Decimal           @db.Decimal(12, 2)
  status            BatchStatus       @default(good)
  receivedById      String?
  createdAt         DateTime          @default(now())
  products          products          @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff             staff?            @relation(fields: [receivedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice_items     invoice_items[]
  stock_movements   stock_movements[]

  @@index([productId])
  @@index([receivedById])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stock_movements {
  id            String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  batchId       String
  type          StockMovementType
  quantity      Int
  reason        String
  performedById String
  createdAt     DateTime          @default(now())
  batches       batches           @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff         staff             @relation(fields: [performedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([batchId])
  @@index([performedById])
}

// ============ 1. Bán hàng ============

model invoices {
  id                 String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  code               String               @unique
  createdAt          DateTime             @default(now())
  cashierId          String
  subtotal           Decimal              @db.Decimal(12, 2)
  discountAmount     Decimal              @default(0) @db.Decimal(12, 2)
  voucherCode        String?
  finalTotal         Decimal              @db.Decimal(12, 2)
  paymentMethod      PaymentMethod
  receivedAmount     Decimal              @db.Decimal(12, 2)
  changeAmount       Decimal              @default(0) @db.Decimal(12, 2)
  paidAt             DateTime?
  status             InvoiceStatus        @default(pending_payment)
  invoice_items      invoice_items[]
  invoice_payments   invoice_payments[]
  invoice_promotions invoice_promotions[]
  staff              staff                @relation(fields: [cashierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cashierId])
  @@index([createdAt])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invoice_items {
  id                 String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  invoiceId          String
  productId          String
  batchId            String?
  quantity           Int
  unitPrice          Decimal              @db.Decimal(12, 2)
  discount           Decimal              @default(0) @db.Decimal(12, 2)
  subtotal           Decimal              @db.Decimal(12, 2)
  batches            batches?             @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices           invoices             @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products           products             @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice_promotions invoice_promotions[]

  @@index([batchId])
  @@index([invoiceId])
  @@index([productId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invoice_payments {
  id            String        @id @default(dbgenerated("(gen_random_uuid())::text"))
  invoiceId     String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(confirmed)
  reference     String?
  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime      @default(now())
  staff         staff?        @relation(fields: [confirmedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoices      invoices      @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([confirmedById])
  @@index([invoiceId])
  @@index([reference])
}

// ============ 3. Khuyến mãi ============

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model promotions {
  id                 String               @id @default(dbgenerated("(gen_random_uuid())::text"))
  code               String               @unique
  name               String
  description        String?
  scope              PromotionScope       @default(order)
  discountType       DiscountType
  value              Decimal              @db.Decimal(12, 2)
  maxDiscountAmount  Decimal?             @db.Decimal(12, 2)
  startDate          DateTime
  endDate            DateTime
  minOrderValue      Decimal              @default(0) @db.Decimal(12, 2)
  applicableCategory Category?
  nearExpiryDays     Int?
  requiresCode       Boolean              @default(false)
  usageLimit         Int?
  usedCount          Int                  @default(0)
  status             PromotionStatus      @default(scheduled)
  createdById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @default(now())
  invoice_promotions invoice_promotions[]
  promotion_products promotion_products[]
  staff              staff?               @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdById])
  @@index([status])
}

model promotion_products {
  promotionId String
  productId   String
  products    products   @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  promotions  promotions @relation(fields: [promotionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([promotionId, productId])
  @@index([productId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model invoice_promotions {
  id             String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  invoiceId      String
  promotionId    String
  invoiceItemId  String?
  discountAmount Decimal        @db.Decimal(12, 2)
  invoices       invoices       @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoice_items  invoice_items? @relation(fields: [invoiceItemId], references: [id], onUpdate: NoAction)
  promotions     promotions     @relation(fields: [promotionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([invoiceId])
  @@index([promotionId])
}

// ============ 6. Nhà cung cấp, đơn đặt hàng ============

model suppliers {
  id               String            @id @default(dbgenerated("(gen_random_uuid())::text"))
  code             String            @unique @default(dbgenerated("next_code('NCC'::text, 'supplier_code_seq'::regclass, 3, 'suppliers'::text, 'code'::text)"))
  name             String
  contactPerson    String
  phone            String
  address          String
  categoryProvided String
  status           SupplierStatus    @default(active)
  purchase_orders  purchase_orders[]
}

model purchase_orders {
  id                   String                 @id @default(dbgenerated("(gen_random_uuid())::text"))
  orderCode            String                 @unique @default(dbgenerated("next_code('PO'::text, 'po_code_seq'::regclass, 4, 'purchase_orders'::text, 'orderCode'::text)"))
  supplierId           String
  createdAt            DateTime               @default(now())
  expectedDate         DateTime
  totalAmount          Decimal                @db.Decimal(14, 2)
  status               PurchaseOrderStatus    @default(pending)
  notes                String?
  purchase_order_items purchase_order_items[]
  suppliers            suppliers              @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([supplierId])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model purchase_order_items {
  id              String          @id @default(dbgenerated("(gen_random_uuid())::text"))
  purchaseOrderId String
  productId       String
  quantity        Int
  unitPrice       Decimal         @db.Decimal(12, 2)
  subtotal        Decimal         @db.Decimal(12, 2)
  products        products        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchase_orders purchase_orders @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId])
  @@index([purchaseOrderId])
}

// ============ 4. Kiểm kê ============

model stock_audits {
  id                     String              @id @default(dbgenerated("(gen_random_uuid())::text"))
  auditCode              String              @unique @default(dbgenerated("next_code('KK'::text, 'audit_code_seq'::regclass, 4, 'stock_audits'::text, 'auditCode'::text)"))
  auditDate              DateTime            @default(now())
  performedById          String
  approvedById           String?
  status                 StockAuditStatus    @default(draft)
  createdAt              DateTime            @default(now())
  stock_audit_items      stock_audit_items[]
  staff_approved         staff?              @relation("stock_audits_approvedByIdTostaff", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staff_performed        staff               @relation("stock_audits_performedByIdTostaff", fields: [performedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([approvedById])
  @@index([performedById])
}

model stock_audit_items {
  id             String       @id @default(dbgenerated("(gen_random_uuid())::text"))
  stockAuditId   String
  productId      String
  systemQuantity Int
  actualQuantity Int
  difference     Int
  reason         String
  products       products     @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stock_audits   stock_audits @relation(fields: [stockAuditId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([productId])
  @@index([stockAuditId])
}

// ============ Enums ============

enum Category {
  SUA_TUOI_TIET_TRUNG
  SUA_TUOI_THANH_TRUNG
  SUA_CHUA
  BO_PHOMAI
  KEM
  NUOC
  TRA
}

enum ProductStatus {
  active
  discontinued
}

enum BatchStatus {
  good
  expiring_soon
  expired
}

enum PaymentMethod {
  cash
  transfer
  card
  mixed
}

enum PaymentStatus {
  pending
  confirmed
  failed
}

enum InvoiceStatus {
  completed
  pending_payment
  cancelled
}

enum StaffStatus {
  active
  inactive
}

enum DiscountType {
  percentage
  fixed_amount
}

enum PromotionStatus {
  draft
  scheduled
  active
  paused
  expired
}

enum PromotionScope {
  order
  category
  product
  near_expiry
}

enum SupplierStatus {
  active
  inactive
}

enum PurchaseOrderStatus {
  pending
  received
  cancelled
}

enum StockAuditStatus {
  draft
  pending_approval
  approved
  rejected
}

enum StockMovementType {
  export
  adjustment
}
